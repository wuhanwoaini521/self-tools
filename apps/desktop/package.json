{
  "name": "devtoolbox-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "DevToolbox desktop shell — Tauri 启动器（UI 工程位于 ui/，脚本转发到子目录）",
  "scripts": {
    "dev": "npm --prefix ui run dev",
    "build": "npm --prefix ui run build",
    "preview": "npm --prefix ui run preview",
    "test:e2e": "node scripts/build-e2e.mjs && wdio run wdio.conf.mjs",
    "test:visual": "node scripts/visual-qa.mjs",
    "test:all": "cargo test --workspace --manifest-path ../../Cargo.toml && npm --prefix ui test && npm run test:e2e && npm run test:visual"
  },
  "devDependencies": {
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-plugin": "^1.4.0",
    "@wdio/tauri-service": "^1.4.0",
    "expect-webdriverio": "^6.1.0",
    "playwright": "^1.63.0"
  }
}
