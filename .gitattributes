# 统一换行符：文本文件入库一律 LF，检出按各平台规则
* text=auto

# 源码 / 配置 / 文档强制 LF
*.css    text eol=lf
*.csv    text eol=lf
*.dict   text eol=lf
*.html   text eol=lf
*.json   text eol=lf
*.lock   text eol=lf
*.md     text eol=lf
*.rs     text eol=lf
*.toml   text eol=lf
*.ts     text eol=lf
*.tsv    text eol=lf
*.tsx    text eol=lf
*.txt    text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
.gitignore    text eol=lf
.gitmodules   text eol=lf
.gitattributes text eol=lf

# 二进制文件不做任何转换
*.png  binary
*.ico  binary
*.icns binary
